{
  "name": "sdh-gamesync",
  "version": "1.1.5-zh.2",
  "description": "SDH-GameSync 简体中文版：游戏启动前下载、退出后上传云端存档",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkazaRenn/SDH-GameSync.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck",
    "cloud",
    "save",
    "backup"
  ],
  "author": "Akaza Renn",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/AkazaRenn/SDH-GameSync/issues"
  },
  "homepage": "https://github.com/AkazaRenn/SDH-GameSync#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "19.0.10",
    "rollup": "^4.68.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.16.5",
    "fastq": "^1.20.3",
    "react-icons": "^5.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
